{
  "expo": {
    "name": "Vinkällaren",
    "slug": "vinkallaren",
    "version": "1.0.0",
    "scheme": "vinkallaren",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "se.raggbock.vinkallaren",
      "infoPlist": {
        "NSCameraUsageDescription": "Kameran används för att skanna streckkoder på vinflaskor."
      },
      "supportsTablet": true
    },
    "android": {
      "package": "se.raggbock.vinkallaren",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "lang": "sv",
      "name": "Vinkällaren — Din digitala vinsamling",
      "description": "Håll koll på din vinsamling, hitta rätt vin till maten och spara smaknoteringar. Gratis och utan reklam.",
      "themeColor": "#2b1714",
      "backgroundColor": "#2b1714"
    }
  }
}
