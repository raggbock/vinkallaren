{
  "name": "mobile-app",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "test": "jest",
    "test:unit": "jest --testPathPattern=src/lib/__tests__",
    "test:hooks": "jest --testPathPattern=src/hooks/__tests__",
    "test:e2e": "npx playwright test --config=e2e/playwright.config.ts",
    "lighthouse": "lhci autorun",
    "lighthouse:prod": "lhci collect --url=https://minvinkallare.se --numberOfRuns=3 && lhci assert",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "prebuild": "node ./scripts/generate-version.mjs",
    "web:build": "node ./scripts/generate-version.mjs && expo export --platform web && node ./scripts/inject-meta.mjs",
    "release:web": "npm run web:build",
    "catalog:seed:sql": "node ./scripts/import-product-catalog-seeds.mjs ./data/product-catalog-seeds.json --sql",
    "catalog:seed:apply": "node ./scripts/import-product-catalog-seeds.mjs ./data/product-catalog-seeds.json --apply",
    "catalog:names:seed:sql": "node ./scripts/import-product-catalog-name-seeds.mjs ./data/wine-name-seeds.json --sql",
    "catalog:names:seed:apply": "node ./scripts/import-product-catalog-name-seeds.mjs ./data/wine-name-seeds.json --apply",
    "catalog:sources:sql": "node ./scripts/import-product-catalog-source-batches.mjs ./data/catalog-source-manifest.json --all --sql",
    "catalog:sources:apply": "node ./scripts/import-product-catalog-source-batches.mjs ./data/catalog-source-manifest.json --all --apply",
    "catalog:systembolaget:sql": "node ./scripts/import-product-catalog-source-batches.mjs ./data/catalog-source-manifest.json --systembolaget --sql",
    "catalog:systembolaget:apply": "node ./scripts/import-product-catalog-source-batches.mjs ./data/catalog-source-manifest.json --systembolaget --apply",
    "catalog:winefinder:fetch": "node ./scripts/fetch-winefinder-red-batch.mjs 5 ./data/catalog-sources/winefinder-red-batch.json",
    "catalog:munskankarna:fetch": "node ./scripts/fetch-munskankarna-playwright.mjs ./data/catalog-sources/munskankarna-wine-batch.json",
    "catalog:munskankarna:sql": "node ./scripts/import-product-catalog-source-batches.mjs ./data/catalog-source-manifest.json --munskänkarna --sql",
    "catalog:munskankarna:apply": "node ./scripts/import-product-catalog-source-batches.mjs ./data/catalog-source-manifest.json --munskänkarna --apply",
    "catalog:munskankarna:rpc": "node ./scripts/import-munskankarna-rpc.mjs ./data/catalog-sources/munskankarna-wine-batch.json",
    "catalog:systembolaget:fetch": "node ./scripts/fetch-systembolaget.mjs ./data/catalog-sources/systembolaget-wine-batch.json",
    "catalog:systembolaget:rpc": "node ./scripts/import-systembolaget-rpc.mjs ./data/catalog-sources/systembolaget-wine-batch.json",
    "catalog:vivino:fetch": "node ./scripts/fetch-vivino-batch.mjs ./data/catalog-sources/vivino-wine-batch.json",
    "catalog:vivino:rpc": "node ./scripts/import-vivino-rpc.mjs ./data/catalog-sources/vivino-wine-batch.json",
    "catalog:vinmonopolet:fetch": "node ./scripts/fetch-vinmonopolet.mjs ./data/catalog-sources/vinmonopolet-wine-batch.json",
    "catalog:vinmonopolet:fetch:quick": "VINMONOPOLET_MAX_DETAILS=0 node ./scripts/fetch-vinmonopolet.mjs ./data/catalog-sources/vinmonopolet-wine-batch.json",
    "catalog:vinmonopolet:match": "node ./scripts/match-vinmonopolet-barcodes.mjs ./data/catalog-sources/vinmonopolet-wine-batch.json --report",
    "catalog:vinmonopolet:sql": "node ./scripts/match-vinmonopolet-barcodes.mjs ./data/catalog-sources/vinmonopolet-wine-batch.json --sql",
    "catalog:vinmonopolet:apply": "node ./scripts/match-vinmonopolet-barcodes.mjs ./data/catalog-sources/vinmonopolet-wine-batch.json --apply",
    "catalog:alko:sql": "node ./scripts/import-product-catalog-source-batches.mjs ./data/catalog-source-manifest.json --alko --sql",
    "catalog:alko:apply": "node ./scripts/import-product-catalog-source-batches.mjs ./data/catalog-source-manifest.json --alko --apply",
    "wine-names:seed:sql": "node ./scripts/import-reference-option-seeds.mjs ./data/wine-name-seeds.json wine_name --sql",
    "wine-names:seed:apply": "node ./scripts/import-reference-option-seeds.mjs ./data/wine-name-seeds.json wine_name --apply"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.0.2",
    "@react-native-ml-kit/text-recognition": "^2.0.0",
    "@supabase/supabase-js": "^2.100.1",
    "expo": "~55.0.9",
    "expo-camera": "~55.0.11",
    "expo-clipboard": "~55.0.9",
    "expo-image-manipulator": "~55.0.11",
    "expo-image-picker": "^55.0.14",
    "expo-status-bar": "~55.0.4",
    "playwright": "^1.58.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "react-test-renderer": "^19.2.0",
    "sharp": "^0.34.5",
    "ts-jest": "^29.4.9",
    "typescript": "~5.9.2",
    "wrangler": "^4.78.0"
  },
  "private": true
}
